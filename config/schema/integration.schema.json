{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "integration.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "output", "azshear", "glm", "cell_history", "stats_datasets", "rap_products"],
  "properties": {
    "schema_version": { "const": 1 },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decimals"],
      "properties": {
        "decimals": { "type": "integer", "minimum": 0 }
      }
    },
    "azshear": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buffer_km", "low_threshold", "mid_threshold", "min_gate_count", "max_pair_separation_km", "history_window"],
      "properties": {
        "buffer_km": { "type": "number" },
        "low_threshold": { "type": "number" },
        "mid_threshold": { "type": "number" },
        "min_gate_count": { "type": "integer", "minimum": 0 },
        "max_pair_separation_km": { "type": "number" },
        "history_window": { "type": "integer", "minimum": 0 }
      }
    },
    "glm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bin_size_degrees"],
      "properties": {
        "bin_size_degrees": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "cell_history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_payloads"],
      "properties": {
        "max_payloads": { "type": "integer", "minimum": 0 }
      }
    },
    "stats_datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "key", "method"],
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "key": { "type": "string" },
          "method": { "type": "string", "enum": ["max", "percentile"] },
          "percentile": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "rap_products": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isobaric_levels_mb", "products", "derived"],
      "properties": {
        "isobaric_levels_mb": { "type": "array", "items": { "type": "integer" } },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["var"],
            "properties": {
              "var": { "type": "string" },
              "aliases": { "type": "array", "items": { "type": "string" } },
              "filter": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "typeOfLevel": { "type": "string" },
                  "level": { "type": "integer" }
                }
              },
              "key": { "type": "string" },
              "key_template": { "type": "string" },
              "transform": { "type": "string" }
            }
          }
        },
        "derived": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "formula"],
            "properties": {
              "key": { "type": "string" },
              "formula": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
