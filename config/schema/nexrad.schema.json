{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nexrad.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "buckets", "stations", "selection", "timeouts", "concurrency", "cli", "retention"],
  "properties": {
    "schema_version": { "const": 1 },
    "buckets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunks", "archive"],
      "properties": {
        "chunks": { "type": "string" },
        "archive": { "type": "string" }
      }
    },
    "stations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_url", "user_agent", "api_timeout_seconds", "api_cache_ttl_seconds"],
      "properties": {
        "catalog_url": { "type": "string" },
        "user_agent": { "type": "string" },
        "api_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "api_cache_ttl_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_vcps", "angle_dedup_tolerance_deg", "high_max_angle_deg", "min_sweep_angle_deg", "canonical_elevation_bins", "min_required_volume_chunks"],
      "properties": {
        "allowed_vcps": { "type": "array", "items": { "type": "integer" } },
        "angle_dedup_tolerance_deg": { "type": "number", "minimum": 0 },
        "high_max_angle_deg": { "type": "number" },
        "min_sweep_angle_deg": { "type": "number", "minimum": 0 },
        "canonical_elevation_bins": { "type": "array", "items": { "type": "number" } },
        "min_required_volume_chunks": { "type": "integer", "minimum": 0 }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume_discovery_seconds", "chunk_list_seconds", "ingest_seconds", "scan_seconds", "cancellation_grace_seconds", "heartbeat_stale_seconds", "heartbeat_startup_grace_seconds"],
      "properties": {
        "volume_discovery_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "chunk_list_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "ingest_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "scan_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "cancellation_grace_seconds": { "type": "number", "minimum": 0 },
        "heartbeat_stale_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "heartbeat_startup_grace_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_site_tasks", "max_chunk_downloads", "worker_pool_size", "worker_recycle_interval", "worker_timeout_seconds"],
      "properties": {
        "max_site_tasks": { "type": "integer", "minimum": 1 },
        "max_chunk_downloads": { "type": "integer", "minimum": 1 },
        "worker_pool_size": { "type": "integer", "minimum": 1 },
        "worker_recycle_interval": { "type": "integer" },
        "worker_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sites", "base_dir", "scan_interval_seconds", "completion_interval_seconds", "max_candidate_volumes_per_site", "max_volumes_per_site", "volume_id"],
      "properties": {
        "sites": { "type": "array", "items": { "type": "string" } },
        "base_dir": { "type": ["string", "null"] },
        "scan_interval_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "completion_interval_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_candidate_volumes_per_site": { "type": "integer", "minimum": 1 },
        "max_volumes_per_site": { "type": "integer", "minimum": 1 },
        "volume_id": { "type": ["string", "null"] }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_dirs_to_keep", "elevation_dirs_to_keep", "stale_manifest_max_age_hours"],
      "properties": {
        "scan_dirs_to_keep": { "type": "integer", "minimum": 0 },
        "elevation_dirs_to_keep": { "type": "integer", "minimum": 0 },
        "stale_manifest_max_age_hours": { "type": "number", "minimum": 0 }
      }
    },
    "env_overrides": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
