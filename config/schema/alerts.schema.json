{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "alerts.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "alerts", "scheduler", "api_index", "runtime"],
  "properties": {
    "schema_version": { "const": 1 },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_severity", "geometry_round_decimals", "cleanup_max_age_minutes"],
      "properties": {
        "default_severity": { "type": "string" },
        "geometry_round_decimals": { "type": "integer", "minimum": 0 },
        "cleanup_max_age_minutes": { "type": ["integer", "null"], "exclusiveMinimum": 0 }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mrms_update_checker_max_entries", "modifier_lookup_max_entries", "s3_lookback_hours", "slow_check_log_threshold_ms"],
      "properties": {
        "mrms_update_checker_max_entries": { "type": "integer", "minimum": 1 },
        "modifier_lookup_max_entries": { "type": "integer", "minimum": 1 },
        "s3_lookback_hours": { "type": "number", "exclusiveMinimum": 0 },
        "slow_check_log_threshold_ms": { "type": "number", "minimum": 0 }
      }
    },
    "api_index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remove_old_cells", "resync_every_updates", "inactive_cell_max_age_minutes"],
      "properties": {
        "remove_old_cells": {
          "type": "object",
          "additionalProperties": false,
          "required": ["realtime", "historical"],
          "properties": {
            "realtime": { "type": "boolean" },
            "historical": { "type": "boolean" }
          }
        },
        "resync_every_updates": { "type": "integer", "minimum": 1 },
        "inactive_cell_max_age_minutes": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialize_indexes"],
      "properties": {
        "initialize_indexes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["realtime", "historical"],
          "properties": {
            "realtime": { "type": "boolean" },
            "historical": { "type": "boolean" }
          }
        }
      }
    }
  }
}
