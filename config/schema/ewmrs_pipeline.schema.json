{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ewmrs_pipeline.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "render", "nexrad_gui", "workers", "render_threads", "caches"],
  "properties": {
    "schema_version": { "const": 1 },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanup_after", "phase_name", "goes_cleanup_max_age_minutes", "goes_cleanup_min_interval_seconds", "gui_cleanup_max_age_minutes"],
      "properties": {
        "cleanup_after": { "type": "boolean" },
        "phase_name": { "type": "string" },
        "goes_cleanup_max_age_minutes": { "type": "integer", "minimum": 1 },
        "goes_cleanup_min_interval_seconds": { "type": "number", "minimum": 0 },
        "gui_cleanup_max_age_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "nexrad_gui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_minutes", "poll_interval_seconds", "poll_interval_min_seconds", "max_workers"],
      "properties": {
        "retention_minutes": { "type": "integer", "minimum": 1 },
        "poll_interval_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "poll_interval_min_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_workers": { "type": "integer", "minimum": 1 }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "budget_mb", "reserve_mb", "psutil_fallback_max", "numeric_thread_caps"],
      "properties": {
        "strategy": { "enum": ["adaptive_memory"] },
        "budget_mb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goes", "default"],
          "properties": {
            "goes": { "type": "number", "exclusiveMinimum": 0 },
            "default": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "reserve_mb": { "type": "number", "minimum": 0 },
        "psutil_fallback_max": { "type": "integer", "minimum": 1 },
        "numeric_thread_caps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "variables"],
          "properties": {
            "value": { "type": "integer", "minimum": 1 },
            "variables": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
            }
          }
        }
      }
    },
    "render_threads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tile_threads"],
      "properties": {
        "max_tile_threads": { "type": "integer", "minimum": 1 }
      }
    },
    "caches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tile_index_entries", "colormap_entries"],
      "properties": {
        "tile_index_entries": { "type": "integer", "minimum": 1 },
        "colormap_entries": { "type": "integer", "minimum": 1 }
      }
    },
    "env_overrides": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
