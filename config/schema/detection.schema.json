{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "detection.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "detection", "tracker", "gatemapper", "morphology", "alert_matching", "hail"],
  "properties": {
    "schema_version": { "const": 1 },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refl_threshold", "min_seed_percentage", "drop_offset", "stormcell_cleanup_max_age_minutes", "fallback_dt_seconds", "tracking_disabled_defaults"],
      "properties": {
        "refl_threshold": { "type": "number" },
        "min_seed_percentage": { "type": "number", "minimum": 0, "maximum": 1 },
        "drop_offset": { "type": "number", "minimum": 0 },
        "stormcell_cleanup_max_age_minutes": { "type": "integer", "minimum": 1 },
        "fallback_dt_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "tracking_disabled_defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tracking_mode", "prediction_count", "event_type"],
          "properties": {
            "tracking_mode": { "type": "string" },
            "prediction_count": { "type": "integer", "minimum": 0 },
            "event_type": { "type": "string" }
          }
        }
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_overlap_ratio"],
      "properties": {
        "lineage_overlap_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "gatemapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crop_pad_px", "reject_clusters_at_or_below_gates", "contour_downsample", "contour_downsample_adaptive", "contour_level", "coordinate_decimals"],
      "properties": {
        "crop_pad_px": { "type": "integer", "minimum": 0 },
        "reject_clusters_at_or_below_gates": { "type": "integer", "minimum": 0 },
        "contour_downsample": { "type": "integer", "minimum": 1 },
        "contour_downsample_adaptive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keep_all_below_points", "coarse_below_points", "keep_all_step", "coarse_step"],
          "properties": {
            "keep_all_below_points": { "type": "integer", "minimum": 1 },
            "coarse_below_points": { "type": "integer", "minimum": 1 },
            "keep_all_step": { "type": "integer", "minimum": 1 },
            "coarse_step": { "type": "integer", "minimum": 1 }
          }
        },
        "contour_level": { "type": "number" },
        "coordinate_decimals": { "type": "integer", "minimum": 0 }
      }
    },
    "morphology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_pixels_full_analysis", "min_contour_points_for_defects"],
      "properties": {
        "min_pixels_full_analysis": { "type": "integer", "minimum": 0 },
        "min_contour_points_for_defects": { "type": "integer", "minimum": 0 }
      }
    },
    "alert_matching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "polygon_match_buffer_deg", "point_match_buffer_deg"],
      "properties": {
        "events": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "polygon_match_buffer_deg": { "type": "number", "minimum": 0 },
        "point_match_buffer_deg": { "type": "number", "minimum": 0 }
      }
    },
    "hail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contour_sampling_step", "preciptype_class", "contour_level"],
      "properties": {
        "contour_sampling_step": { "type": "integer", "minimum": 1 },
        "preciptype_class": { "type": "integer" },
        "contour_level": { "type": "number" }
      }
    },
    "env_overrides": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
