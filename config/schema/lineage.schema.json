{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lineage.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lineage"],
  "properties": {
    "schema_version": { "const": 1 },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracked_overlap_ratio", "bounds_prefilter_buffer_deg", "buffer"],
      "properties": {
        "tracked_overlap_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "bounds_prefilter_buffer_deg": { "type": "number", "minimum": 0 },
        "buffer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_confirmations", "max_pending", "prune_after_scans", "scan_interval_seconds"],
          "properties": {
            "min_confirmations": { "type": "integer", "minimum": 1 },
            "max_pending": { "type": "integer", "minimum": 1 },
            "prune_after_scans": { "type": "integer", "minimum": 1 },
            "scan_interval_seconds": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
