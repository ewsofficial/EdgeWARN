{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wpc.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "wpc"],
  "properties": {
    "schema_version": { "const": 1 },
    "wpc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coded_sfc_base_url", "update_interval_hours", "http_timeout_seconds", "verify_tls", "date_format", "remote_filename_pattern", "output_filename_pattern", "latest_filename", "surface_filename_prefix", "surface_filename_suffix", "cleanup_glob", "cleanup_max_age_minutes", "previous_analysis_lookback_hours", "fallback_geojson_color", "feature_types"],
      "properties": {
        "coded_sfc_base_url": { "type": "string", "pattern": "^https://" },
        "update_interval_hours": { "type": "integer", "enum": [1, 2, 3, 4, 6, 8, 12] },
        "http_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "verify_tls": { "type": "boolean", "const": true },
        "date_format": { "type": "string" },
        "remote_filename_pattern": { "type": "string" },
        "output_filename_pattern": { "type": "string" },
        "latest_filename": { "type": "string" },
        "surface_filename_prefix": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "surface_filename_suffix": { "type": "string", "pattern": "^\\.[A-Za-z0-9.]+$" },
        "cleanup_glob": { "type": "string" },
        "cleanup_max_age_minutes": { "type": "integer", "minimum": 1 },
        "previous_analysis_lookback_hours": { "type": "number", "exclusiveMinimum": 0 },
        "fallback_geojson_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "feature_types": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "color"],
            "properties": {
              "name": { "type": "string" },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
            }
          }
        }
      }
    }
  }
}
