{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "filesystem.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cleanup_defaults"],
  "properties": {
    "schema_version": { "const": 1 },
    "cleanup_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_age_minutes", "max_files"],
      "properties": {
        "max_age_minutes": { "type": "integer", "minimum": 0 },
        "max_files": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "env_overrides": {
      "type": "object",
      "additionalProperties": { "type": ["string", "array"], "items": { "type": "string" } }
    }
  }
}
