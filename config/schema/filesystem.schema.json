{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "filesystem.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_dir", "cleanup_defaults", "colormap_search_path"],
  "properties": {
    "schema_version": { "const": 1 },
    "base_dir": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posix", "windows"],
      "properties": {
        "posix": { "type": "string" },
        "windows": { "type": "string" }
      }
    },
    "cleanup_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_age_minutes", "max_files"],
      "properties": {
        "max_age_minutes": { "type": "integer", "minimum": 0 },
        "max_files": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "colormap_search_path": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^<(base_dir|gui_dir|src_dir)>/[^/]"
      }
    }
  }
}
