{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "historical.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "historical"],
  "properties": {
    "schema_version": { "const": 1 },
    "historical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon", "output", "step_minutes", "throttle_seconds", "cleanup_max_files"],
      "properties": {
        "lat": { "type": "array", "items": { "type": "number", "minimum": -90, "maximum": 90 }, "minItems": 2, "maxItems": 2 },
        "lon": { "type": "array", "items": { "type": "number", "minimum": -180, "maximum": 180 }, "minItems": 2, "maxItems": 2 },
        "output": { "type": "string" },
        "step_minutes": { "type": "integer", "minimum": 1 },
        "throttle_seconds": { "type": "number", "minimum": 0 },
        "cleanup_max_files": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
