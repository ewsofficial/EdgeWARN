{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metar.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metar"],
  "properties": {
    "schema_version": { "const": 1 },
    "metar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_db_url", "station_cache_file", "observation_url_pattern", "station_timeout_seconds", "observation_timeout_seconds", "accept_encoding", "verify_tls", "lookback_hours", "cleanup_max_age_minutes", "coordinate_decimals", "pressure_decimals", "conus_bounds"],
      "properties": {
        "station_db_url": { "type": "string", "pattern": "^https://" },
        "station_cache_file": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "observation_url_pattern": { "type": "string", "pattern": "^https://.*\\{hour\\}" },
        "station_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "observation_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "accept_encoding": { "type": "string" },
        "verify_tls": { "type": "boolean" },
        "lookback_hours": { "type": "integer", "minimum": 1 },
        "cleanup_max_age_minutes": { "type": "integer", "minimum": 1 },
        "coordinate_decimals": { "type": "integer", "minimum": 0 },
        "pressure_decimals": { "type": "integer", "minimum": 0 },
        "conus_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat_min", "lat_max", "lon_min", "lon_max"],
          "properties": {
            "lat_min": { "type": "number" },
            "lat_max": { "type": "number" },
            "lon_min": { "type": "number" },
            "lon_max": { "type": "number" }
          }
        }
      }
    }
  }
}
