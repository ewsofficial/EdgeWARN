{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mrms_goes.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mrms", "goes"],
  "properties": {
    "schema_version": { "const": 1 },
    "mrms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket", "decompress_chunk_size_bytes",
        "remove_old_files", "cleanup_max_age_minutes", "cadence_minutes",
        "rounding_half_up_seconds", "staged_filename_pattern", "path_patterns",
        "ncep_https", "products", "check_products", "membership_lists"
      ],
      "properties": {
        "bucket": { "type": "string" },
        "decompress_chunk_size_bytes": { "type": "integer", "exclusiveMinimum": 0 },
        "remove_old_files": { "type": "boolean" },
        "cleanup_max_age_minutes": { "type": "integer", "minimum": 1 },
        "cadence_minutes": { "type": "integer", "minimum": 1 },
        "rounding_half_up_seconds": { "type": "integer", "minimum": 0, "maximum": 59 },
        "staged_filename_pattern": { "type": "string" },
        "path_patterns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "s3_prefix", "s3_prefix_no_modifier", "filename_prefix",
            "probsevere_start_after", "probsevere_start_after_lookback_hours"
          ],
          "properties": {
            "s3_prefix": { "type": "string" },
            "s3_prefix_no_modifier": { "type": "string" },
            "filename_prefix": { "type": "string" },
            "probsevere_start_after": { "type": "string" },
            "probsevere_start_after_lookback_hours": { "type": "integer", "minimum": 0 }
          }
        },
        "ncep_https": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_url", "probsevere_url", "sync_timeout_seconds",
            "match_window_seconds", "download_chunk_size_bytes",
            "directory_split_token", "directory_map"
          ],
          "properties": {
            "base_url": { "type": "string", "pattern": "^https://" },
            "probsevere_url": { "type": "string", "pattern": "^https://" },
            "sync_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "match_window_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "download_chunk_size_bytes": { "type": "integer", "exclusiveMinimum": 0 },
            "directory_split_token": { "type": "string" },
            "directory_map": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "products": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region", "product", "outdir"],
            "properties": {
              "region": { "type": "string" },
              "product": { "type": ["string", "null"] },
              "outdir": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
            }
          }
        },
        "check_products": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region", "product", "outdir"],
            "properties": {
              "region": { "type": "string" },
              "product": { "type": ["string", "null"] },
              "outdir": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
            }
          }
        },
        "membership_lists": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detection"],
          "properties": {
            "detection": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "goes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket", "abi_product", "glm_product", "glm_outdir",
        "max_files_per_spec", "max_entries", "hour_lookback",
        "cleanup_max_age_minutes", "bucket_path_pattern",
        "filename_matcher_template", "abi_channels"
      ],
      "properties": {
        "bucket": { "type": "string" },
        "abi_product": { "type": "string" },
        "glm_product": { "type": "string" },
        "glm_outdir": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "max_files_per_spec": { "type": "integer", "minimum": 1 },
        "max_entries": { "type": "integer", "minimum": 1 },
        "hour_lookback": { "type": "integer", "minimum": 1 },
        "cleanup_max_age_minutes": { "type": "integer", "minimum": 1 },
        "bucket_path_pattern": { "type": "string" },
        "filename_matcher_template": { "type": "string" },
        "abi_channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "outdir"],
            "properties": {
              "id": { "type": "string", "pattern": "^C[0-9]{2}$" },
              "name": { "type": "string" },
              "outdir": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
            }
          }
        }
      }
    }
  }
}
